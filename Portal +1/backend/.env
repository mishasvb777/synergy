PORT=4000
USE_PGLITE=1
# When Docker Postgres is available, set USE_PGLITE=0 and:
# DATABASE_URL=postgresql://portal:portal@localhost:5432/portal_plus1
REDIS_URL=redis://localhost:6379
JWT_SECRET=portal-plus1-dev-secret-change-me
JWT_EXPIRES_IN=8h
SKIP_REDIS=1
APP_PUBLIC_URL=http://localhost:5173
# Optional real SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Portal+1 <noreply@innotech.local>
# Or Ethereal test inbox: SMTP_ETHEREAL=1
